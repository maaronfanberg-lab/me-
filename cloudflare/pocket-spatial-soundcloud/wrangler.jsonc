{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocket-spatial-soundcloud-auth",
  "main": "src/index.js",
  "compatibility_date": "2026-09-06",
  "vars": {
    "APP_URL": "https://maaronfanberg-lab.github.io/me-/apps/pocket-spatial.html",
    "ALLOWED_ORIGIN": "https://maaronfanberg-lab.github.io"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
