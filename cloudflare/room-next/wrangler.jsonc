{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "room-next",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      { "name": "WorldAgent", "class_name": "WorldAgent" },
      { "name": "CharacterAgent", "class_name": "CharacterAgent" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorldAgent", "CharacterAgent"]
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  }
}
