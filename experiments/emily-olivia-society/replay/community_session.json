    },
    {
      "id": 15,
      "from_id": 1,
      "from_name": "Emily",
      "to_id": 2,
      "to_name": "Olivia",
      "content": "What? What did I do that was so bad?",
      "created_at": "2026-09-07T17:52:38.734734+00:00"
    },
    {
      "id": 16,
      "from_id": 2,
      "from_name": "Olivia",
      "to_id": 1,
      "to_name": "Emily",
      "content": "Did you just say that in the last message?",
