      "from_name": "Olivia",
      "to_id": 1,
      "to_name": "Emily",
      "content": "What do you mean?",
      "created_at": "2026-09-10T00:53:29.540065+00:00"
    },
    {
      "id": 19,
      "from_id": 1,
      "from_name": "Emily",
      "to_id": 2,
