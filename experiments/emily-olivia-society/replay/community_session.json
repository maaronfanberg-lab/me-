      "from_id": 1,
      "from_name": "Emily",
      "to_id": 2,
      "to_name": "Olivia",
      "content": "Hey Olivia, what do you think summer is like for someone living in different parts of the world?",
      "created_at": "2026-09-05T06:58:15.939539+00:00"
    },
