    },
    {
      "id": 3,
      "from_id": 1,
      "from_name": "Emily",
      "to_id": 2,
      "to_name": "Olivia",
      "content": "That's wonderful to hear! I just started playing violin this year. It's really enjoyable and relaxing.",
      "created_at": "2026-09-04T23:31:16.897257+00:00"
    },
    {
      "id": 4,
      "from_id": 2,
      "from_name": "Olivia",
      "to_id": 1,
      "to_name": "Emily",
      "content": "That's really cool! What kind of music do you like to listen to?",
      "created_at": "2026-09-04T23:31:43.007295+00:00"
    },
    {
      "id": 5,
      "from_id": 1,
      "from_name": "Emily",
      "to_id": 2,
      "to_name": "Olivia",
      "content": "Wow, that's really cool. I just started playing violin this year.",
      "created_at": "2026-09-04T23:32:05.115043+00:00"
    },
    {
      "id": 6,
      "from_id": 2,
      "from_name": "Olivia",
      "to_id": 1,
      "to_name": "Emily",
      "content": "Emily, I love the way you talk. Can't wait to get to know you better.",
      "created_at": "2026-09-04T23:36:14.854423+00:00"
    },
    {
      "id": 7,
      "from_id": 1,
      "from_name": "Emily",
      "to_id": 2,
      "to_name": "Olivia",
      "content": "Oh, it's great that we could talk! What about you?",
