      "from_id": 1,
      "from_name": "Emily",
      "to_id": 2,
      "to_name": "Olivia",
      "content": "I appreciate the compliment on my food, but I'm a vegetarian. How about you?",
      "created_at": "2026-09-14T05:50:44.775701+00:00"
