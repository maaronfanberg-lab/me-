      "from_id": 1,
      "from_name": "Emily",
      "to_id": 2,
      "to_name": "Olivia",
      "content": "Thank you so much for all the information! It's really helpful and appreciated.",
      "created_at": "2026-10-04T09:10:49.030838+00:00"
    },
