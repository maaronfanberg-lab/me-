    {
      "id": 7,
      "from_id": 1,
      "from_name": "Emily",
      "to_id": 2,
      "to_name": "Olivia",
      "content": "It's really cool that you said that. I didn't know I was the type that would appreciate it so much.",
      "created_at": "2026-09-28T08:06:32.439836+00:00"
    },
    {
      "id": 8,
