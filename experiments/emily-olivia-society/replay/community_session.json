    },
    {
      "id": 8,
      "from_id": 2,
      "from_name": "Olivia",
      "to_id": 1,
      "to_name": "Emily",
      "content": "You know, Emily. I always thought that music was a beautiful and diverse art form. Do you think there is any particular genre or style of music that you particularly enjoy?",
      "created_at": "2026-09-04T23:39:54.498275+00:00"
    },
    {
