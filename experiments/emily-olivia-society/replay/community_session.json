    {
      "id": 11,
      "from_id": 1,
      "from_name": "Emily",
      "to_id": 2,
      "to_name": "Olivia",
      "content": "Thank you for the suggestion! I will definitely look into it and see what events we have. Maybe some of them might be good matches for my interests and needs right now.",
      "created_at": "2026-09-29T20:41:14.339896+00:00"
