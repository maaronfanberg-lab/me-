      "from_id": 2,
      "from_name": "Olivia",
      "to_id": 1,
      "to_name": "Emily",
      "content": "Yeah, I'd like to see the different animals that they have. What is their biggest animal?",
      "created_at": "2026-10-04T10:44:46.510599+00:00"
    },
