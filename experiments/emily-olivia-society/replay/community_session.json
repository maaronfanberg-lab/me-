    },
    {
      "id": 5,
      "from_id": 1,
      "from_name": "Emily",
      "to_id": 2,
      "to_name": "Olivia",
      "content": "Oh, that's really interesting! I can tell why you were worried because I saw the message.",
      "created_at": "2026-09-21T16:01:52.478615+00:00"
    },
    {
      "id": 6,
      "from_id": 2,
      "from_name": "Olivia",
      "to_id": 1,
      "to_name": "Emily",
      "content": "Oh, I see. Could you tell me more about your family situation?",
