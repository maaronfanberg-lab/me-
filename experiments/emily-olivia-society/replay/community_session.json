    },
    {
      "id": 21,
      "from_id": 1,
      "from_name": "Emily",
      "to_id": 2,
      "to_name": "Olivia",
      "content": "Oh, I'm so sorry that you misunderstood! You know how it is with me sometimes, and I didn't realize what I said.",
