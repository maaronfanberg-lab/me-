    {
      "id": 26,
      "from_id": 2,
      "from_name": "Olivia",
      "to_id": 1,
      "to_name": "Emily",
      "content": "Oh wow, I didn't know you were a vegetarian! That is so cool, how do you find it? Are there any special dishes or things that you would like to try?",
      "created_at": "2026-09-14T05:56:04.114307+00:00"
    },
