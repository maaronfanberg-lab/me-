    },
    {
      "id": 8,
      "from_id": 2,
      "from_name": "Olivia",
      "to_id": 1,
      "to_name": "Emily",
      "content": "Thank you for your kind words, Emily. I've been talking with my best friend, Emma, about it. It's just been a couple of days and I haven't been feeling myself.",
