      "from_name": "Olivia",
      "to_id": 1,
      "to_name": "Emily",
      "content": "Thank you so much for your kind words!",
      "created_at": "2026-09-07T19:09:47.374925+00:00"
    },
    {
      "id": 31,
      "from_id": 1,
      "from_name": "Emily",
      "to_id": 2,
